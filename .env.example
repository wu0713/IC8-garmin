# 複製成 .env 再修改：cp .env.example .env

# 朋友註冊時要輸入的邀請碼。對外開放時一定要設！
INVITE_CODE=換成你自己的邀請碼

# 對外網址（Tailscale Funnel / Cloudflare Tunnel 給你的 https 網址），用來產生行事曆訂閱連結
# 例：PUBLIC_BASE_URL=https://my-pc.tail1234.ts.net
PUBLIC_BASE_URL=

# 每天自動同步 Garmin 的時間（24 小時制，逗號分隔）
SYNC_HOURS=5,13,21

# 自動偵測新資料：每隔幾分鐘問一次 Garmin「手錶最後上傳時間」，有變才同步（0 = 關閉）
# 在 Garmin Connect 同步後，最慢這麼多分鐘就會自己抓進來。被 Garmin 限流時可以調長。
POLL_MINUTES=10
# 只在這段時間偵測（24 小時制，開始-結束）
POLL_HOURS=5-23

TZ_NAME=Asia/Taipei

# 允許使用範例資料（1 = 允許）
ALLOW_DEMO=1

# 加密 Garmin token 的金鑰。不填會自動產生在 data/secret.key（搬家時連 data/ 一起搬）
# SECRET_KEY=
